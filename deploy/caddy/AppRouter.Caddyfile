{
	auto_https off
}

# Reboot-safe fallback: only the active blue/green container normally exists,
# so health checks select it. During a release, update.sh gracefully reloads an
# equivalent config containing only the verified candidate before stopping the
# previous slot.
:3000 {
	reverse_proxy app-blue:3000 app-green:3000 {
		lb_policy first
		lb_try_duration 5s
		lb_try_interval 250ms

		health_uri /api/health
		health_interval 10s
		# The handler gives each dependency up to 5s. Leave transport headroom
		# for scheduling/JSON and require two consecutive failed probes, so one
		# slow data-api sample cannot eject the sole active application slot.
		health_timeout 8s
		health_status 200
		health_fails 2
		health_passes 1

		# Deliberately no passive `unhealthy_status 5xx` / `max_fails` /
		# `fail_duration`. With one app slot normally running, ejecting the
		# upstream on a single 5xx RESPONSE means one failed request takes the
		# whole site down - measured on production 2026-09-21: a company import
		# chunk carrying a NUL byte returned 500 at 17:47:03, and for the next
		# 30s every request, including the button to cancel that very import,
		# got Caddy's own "no upstreams available" 503 with no JSON body ("Request
		# failed (503)."). An application error means that request failed, not
		# that the process is unfit to serve - which is what /api/health above
		# is for. Two active probes remove a persistently dead slot in ~20s.
		# Connection-level failures still fail over through lb_try_duration.

		header_up X-Forwarded-Proto https
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
