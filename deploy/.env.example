# ═══════════════════════════════════════════════════════════════════════════
# Prospect Sync — self-hosted stack configuration
#
#   cp .env.example .env
#   ./scripts/gen-secrets.sh        # fills in every SECRET/KEY/PASSWORD below
#   ./scripts/check-images.sh       # verifies the image tags actually exist
#
# Quote any value containing spaces. Docker Compose tolerates bare spaces here,
# but the maintenance scripts `source` this file and bash does not.
#
# .env holds your service-role key and database password. It must never be
# committed. `chmod 600 .env` after creating it.
# ═══════════════════════════════════════════════════════════════════════════

# ── Domains ────────────────────────────────────────────────────────────────
# Three A records, all pointing at your Hostinger VPS IPv4.
APP_DOMAIN=app.clearroadco.link
API_DOMAIN=api.clearroadco.link
STUDIO_DOMAIN=studio.clearroadco.link
ACME_EMAIL=you@clearroadco.link

# Derived; keep these consistent with the three values above.
APP_PUBLIC_URL=https://app.clearroadco.link
SUPABASE_PUBLIC_URL=https://api.clearroadco.link

# ── Application ────────────────────────────────────────────────────────────
# Container image built and pushed by .github/workflows/deploy.yml.
APP_IMAGE=ghcr.io/senthil221/prospect-sync:latest

# Same allowlist semantics as today. Must match users that exist in Studio.
ALLOWED_USER_EMAILS=owner@example.com,boss@example.com

# ── Secrets — generated by scripts/gen-secrets.sh, do not hand-edit ────────
POSTGRES_DB=postgres
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# Studio HTTP basic auth. One login per line in the Caddyfile; both pairs
# below are required as long as the Caddyfile's basic_auth block has both
# lines. Hashes are produced by `caddy hash-password`. Use each person's email
# as the username so failed-login logs are attributable.
#
# Double every $ in the hash (bcrypt hashes look like $2a$14$...) before
# pasting it in: docker compose re-interpolates .env values, and a lone $
# segment that happens to start with a letter gets read as an env var
# reference and silently truncates the hash. gen-secrets.sh does this
# escaping for you for the first pair; do it by hand for the second.
STUDIO_BASIC_AUTH_USER=admin
STUDIO_BASIC_AUTH_HASH=
STUDIO_BASIC_AUTH_USER_2=
STUDIO_BASIC_AUTH_HASH_2=
# Space-separated CIDRs allowed to reach Studio before basic auth. The default
# permits Tailscale and loopback only. Add a fixed office/home IP as x.x.x.x/32
# if you cannot use Tailscale. If you need Studio reachable from arbitrary,
# changing IPs, set STUDIO_ALLOWED_CIDRS="0.0.0.0/0 ::/0" — this removes the
# IP lock entirely and leaves basic auth as the only gate, so also run
# scripts/setup-studio-fail2ban.sh so repeated failed logins get banned.
STUDIO_ALLOWED_CIDRS="100.64.0.0/10 127.0.0.1/32 ::1"

# Only read when COMPOSE_PROFILES includes `realtime`.
REALTIME_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

# ── Auth behaviour ─────────────────────────────────────────────────────────
# true  = users you create in Studio are immediately usable, no email needed.
# false = requires working SMTP below. Keep `true` unless you add password
#         reset / invite flows.
GOTRUE_MAILER_AUTOCONFIRM=true

# Optional. You run a cold-email agency, so you have SMTP — but do NOT reuse a
# sending domain you use for outbound campaigns. Use a subdomain or a
# transactional provider so auth mail cannot affect campaign deliverability.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@example.com
SMTP_SENDER_NAME="Prospect Sync"

# ── Optional services ──────────────────────────────────────────────────────
# Comma-separated, from: storage, realtime, functions
# Leave empty until you actually need them — each one costs RAM you would
# rather give to PostgreSQL's page cache.
COMPOSE_PROFILES=

# Schemas PostgREST exposes. Add more as you grow (e.g. public,api).
PGRST_DB_SCHEMAS=public

# ── Studio labels ──────────────────────────────────────────────────────────
STUDIO_ORG_NAME="Prospect Sync"
STUDIO_PROJECT_NAME=Production

# ── Image tags ─────────────────────────────────────────────────────────────
# These were current when this file was written. VERIFY THEM before your first
# deploy — run ./scripts/check-images.sh, and cross-check against the pins in
# https://github.com/supabase/supabase/blob/master/docker/docker-compose.yml
#
# Pin exact tags, never `latest`. Upgrading is then a one-line diff you can
# revert, which is the whole point of self-hosting on a schedule you control.
POSTGRES_IMAGE_TAG=15.8.1.060
GOTRUE_IMAGE_TAG=v2.177.0
POSTGREST_IMAGE_TAG=v12.2.12
POSTGRES_META_IMAGE_TAG=v0.91.0
STUDIO_IMAGE_TAG=2025.06.30-sha-6f5982d
CADDY_IMAGE_TAG=2-alpine
STORAGE_IMAGE_TAG=v1.25.7
IMGPROXY_IMAGE_TAG=v3.8.0
REALTIME_IMAGE_TAG=v2.34.47
EDGE_RUNTIME_IMAGE_TAG=v1.67.4

# ── Backups ────────────────────────────────────────────────────────────────
# Local retention in days. Offsite copies are governed by the bucket lifecycle.
BACKUP_RETENTION_DAYS=7

# Offsite target. Cloudflare R2 (no egress fees) or Backblaze B2 both work.
# Leave RESTIC_REPOSITORY empty to keep local-only backups (not recommended:
# a single VPS failure then loses the database and its backups together).
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
