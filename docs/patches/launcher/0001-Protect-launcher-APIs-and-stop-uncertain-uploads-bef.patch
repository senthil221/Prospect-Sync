diff --git a/src/views/AccessGate.tsx b/src/views/AccessGate.tsx
new file mode 100644
index 0000000..a49e8a0
--- /dev/null
+++ b/src/views/AccessGate.tsx
@@ -0,0 +1,30 @@
+import { useState, type ReactNode } from 'react';
+import { setAccessToken } from '../lib/access';
+
+export default function AccessGate({ children }: { children: ReactNode }) {
+  const [ready, setReady] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  if (ready) return <>{children}</>;
+  return <main style={{ maxWidth: 480, margin: '80px auto', padding: 24 }}>
+    <h1>Campaign Launcher access</h1>
+    <p>Enter your separate launcher access token. Do not enter a Smartlead API key.</p>
+    <form onSubmit={async event => {
+      event.preventDefault(); const form = event.currentTarget;
+      const token = String(new FormData(form).get('token') ?? '').trim(); form.reset();
+      setBusy(true); setError('');
+      try {
+        const response = await fetch('/api/session', { headers: { Authorization: `Bearer ${token}` }, cache: 'no-store', signal: AbortSignal.timeout(10000) });
+        if (!response.ok) throw new Error('Access rejected or not configured.');
+        setAccessToken(token); setReady(true);
+      } catch (e) { setError(e instanceof Error ? e.message : 'Unable to sign in.'); }
+      finally { setBusy(false); }
+    }}>
+      <label htmlFor="launcher-access">Launcher access token</label>
+      <input id="launcher-access" name="token" type="password" autoComplete="off" required disabled={busy}/>
+      <button disabled={busy}>{busy ? 'Checking…' : 'Continue'}</button>
+    </form>
+    {error && <p role="alert">{error}</p>}
+    <p>The token stays in this tab only. Closing or reloading requires signing in again.</p>
+  </main>;
+}
diff --git a/tests/access.test.mjs b/tests/access.test.mjs
new file mode 100644
index 0000000..69130a4
--- /dev/null
+++ b/tests/access.test.mjs
@@ -0,0 +1,39 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import main from '../api/smartlead.js';
+import tags from '../api/smartlead-tags.js';
+import accounts from '../api/smartlead-tag-accounts.js';
+import { allowedOperation } from '../api/_lib/access.js';
+
+const token = 'a'.repeat(43);
+const hash = createHash('sha256').update(token).digest('hex');
+function response() { return { headers: {}, code: 0, value: '', status(n) { this.code = n; return this; }, setHeader(k,v) { this.headers[k] = v; return this; }, end(v) { this.value = v; return this; } }; }
+test('all three routes deny missing or wrong authentication before fetch', async () => {
+  const prior = globalThis.fetch; const old = process.env.LAUNCHER_ACCESS_TOKEN_SHA256;
+  process.env.LAUNCHER_ACCESS_TOKEN_SHA256 = hash;
+  globalThis.fetch = async () => { throw new Error('Unexpected upstream call'); };
+  try {
+    for (const handler of [main, tags, accounts]) for (const authorization of [undefined, 'Bearer wrong']) {
+      const res = response(); await handler({ method: handler === main ? 'POST' : 'GET', headers: { authorization }, query: {} }, res);
+      assert.equal(res.code, 401); assert.equal(res.headers['Cache-Control'], 'private, no-store');
+    }
+  } finally { globalThis.fetch = prior; if (old === undefined) delete process.env.LAUNCHER_ACCESS_TOKEN_SHA256; else process.env.LAUNCHER_ACCESS_TOKEN_SHA256 = old; }
+});
+test('allowlist rejects alternate representations and arbitrary methods', () => {
+  for (const path of ['/campaigns/1/leads?x=y', '/campaigns/%31/leads', '/campaigns/../create', '/campaigns/0/leads', '/campaigns/1/leads#x']) assert.equal(allowedOperation('POST', path, undefined), false);
+  assert.equal(allowedOperation('DELETE', '/campaigns/1/leads', undefined), false);
