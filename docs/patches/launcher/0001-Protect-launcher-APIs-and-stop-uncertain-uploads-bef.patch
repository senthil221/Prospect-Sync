index 1c710d0..55dd194 100644
--- a/README.md
+++ b/README.md
@@ -1,6 +1,14 @@
 # Campaign Launcher
 
-Production-grade Smartlead campaign launcher for cold email teams. Upload your CSVs, pick a schedule template, and launch or save as draft — all from a clean browser UI.
+Smartlead campaign launcher for cold email teams. This standalone browser runner
+is not a durable background queue. Prospect Sync's integration is the target for
+resumable large jobs. Failed or uncertain uploads now stop without activation.
+
+All APIs require a separate high-entropy launcher access token. Configure its
+SHA-256 hex digest as LAUNCHER_ACCESS_TOKEN_SHA256 on the server; distribute the
+token privately to authorized operators. It is held in tab memory only. This is
+a single-operator access gate, not multi-user identity/auditing or an SSO system.
+Do not deploy this change without provisioning that separate token.
 
 ## Setup in 3 commands
 
@@ -13,8 +21,8 @@ npm run dev
 ## .env setup
 
 ```env
-VITE_SMARTLEAD_API_KEY=your_api_key_here
-VITE_SMARTLEAD_BASE_URL=https://server.smartlead.ai/api/v1
+SMARTLEAD_API_KEY=your_server_only_api_key_here
+LAUNCHER_ACCESS_TOKEN_SHA256=sha256_hex_digest_of_separate_random_access_token
 ```
 
 ## CSV formats
@@ -41,7 +49,11 @@ npm run build   # outputs to dist/
 vercel --prod
 ```
 
-Set `VITE_SMARTLEAD_API_KEY` and `VITE_SMARTLEAD_BASE_URL` as Vercel environment variables.
+Set `SMARTLEAD_API_KEY` and `LAUNCHER_ACCESS_TOKEN_SHA256` as server-only Vercel
+environment variables. Never put provider credentials in VITE variables or browser
+storage. Rotate any provider key previously exposed in a frontend build. Local
+Vite alone does not serve the protected API routes; use the Vercel development
+runtime for an end-to-end local session.
 
 ## Architecture
 
diff --git a/api/_lib/access.js b/api/_lib/access.js
new file mode 100644
index 0000000..a4810ab
--- /dev/null
+++ b/api/_lib/access.js
@@ -0,0 +1,20 @@
+import { createHash, timingSafeEqual } from 'node:crypto';
+
+export function requireAccess(req, res) {
+  res.setHeader('Cache-Control', 'private, no-store');
+  res.setHeader('Vary', 'Authorization');
+  const expected = process.env.LAUNCHER_ACCESS_TOKEN_SHA256;
+  const authorization = req.headers?.authorization;
+  const configured = typeof expected === 'string' && /^[a-fA-F0-9]{64}$/.test(expected);
+  const valid = configured && typeof authorization === 'string' && /^Bearer [A-Za-z0-9_-]{43,128}$/.test(authorization)
+    && timingSafeEqual(createHash('sha256').update(authorization.slice(7)).digest(), Buffer.from(expected, 'hex'));
+  if (valid) return true;
+  res.status(configured ? 401 : 503).setHeader('Content-Type', 'application/json');
+  res.end(JSON.stringify({ error: configured ? 'Launcher access required.' : 'Launcher access is not configured.' }));
+  return false;
+}
+
+export function allowedOperation(method, path, params) {
+  return method === 'POST' && params === undefined && typeof path === 'string'
+    && (/^\/campaigns\/create$/.test(path) || /^\/campaigns\/[1-9][0-9]{0,14}\/(sequences|email-accounts|schedule|settings|leads|status)$/.test(path));
+}
